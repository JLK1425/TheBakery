<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras - The Bakery</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <a href="index.html" class="text-2xl font-bold text-pink-600 tracking-tighter">TheBakery</a>
                <a href="index.html" class="text-gray-600 hover:text-pink-600 transition">Seguir Comprando</a>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <h1 class="text-3xl font-bold mb-8">Tu Carrito</h1>

        <div class="flex flex-col lg:flex-row gap-10">

            <div class="lg:w-2/3">
                <div id="cartItemsContainer" class="space-y-6">
                    <p class="text-gray-500 text-center py-10">Cargando carrito...</p>
                </div>
            </div>

            <div class="lg:w-1/3">
                <div class="bg-white p-6 rounded-xl shadow-lg sticky top-24">
                    <h2 class="text-xl font-semibold mb-6 border-b pb-2">Resumen del Pedido</h2>

                    <p id="itemCount" class="text-sm text-gray-500 mb-4">0 productos</p>

                    <div class="space-y-3 mb-6">
                        <div class="flex justify-between text-gray-600">
                            <span>Subtotal</span>
                            <span id="subtotal">RD$0.00</span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Impuestos (18%)</span>
                            <span id="taxes">RD$0.00</span>
                        </div>
                        <div class="flex justify-between text-xl font-bold text-gray-900 pt-4 border-t">
                            <span>Total</span>
                            <span id="total">RD$0.00</span>
                        </div>
                    </div>

                    <div id="checkoutBtn"
                         role="button"
                         tabindex="0"
                         aria-label="Pagar con Stripe"
                         class="w-full bg-pink-600 hover:bg-pink-700 text-white font-bold py-4 rounded-lg text-center cursor-pointer transition transform hover:scale-[1.02] shadow-md select-none">
                        💳 Pagar con Stripe
                    </div>

                    <p id="error-msg" class="text-red-500 text-sm mt-3 text-center hidden"></p>
                </div>
            </div>
        </div>
    </main>

    <script src="TheBakery/assets/js/cart.js?v=new_clean_1"></script>
</body>
</html>
